# Copy this file to .env locally, then fill in your real key.
# Never paste real API keys into chat or commit them to the project.

ZHIPU_API_KEY=

# Official docs currently show glm-5.2 in examples. If your account has GLM-5.3 API access,
# set this to the exact model id shown in the 智谱 BigModel console/docs.
ZHIPU_MODEL=glm-5.2
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Bocha Web Search API. Keep the real key only in local .env.
BOCHA_API_KEY=
BOCHA_BASE_URL=https://api.bochaai.com/v1

# DeepSeek is only used by the constrained text layer. Keep the real key local.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
MOTOMATE_NEED_EXTRACTOR_ENABLED=false
MOTOMATE_EXPLANATION_GENERATOR_ENABLED=false
