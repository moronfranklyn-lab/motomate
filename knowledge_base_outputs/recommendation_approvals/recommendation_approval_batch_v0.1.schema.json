{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recommendation_approval_batch_v0.1.schema.json",
  "title": "MotoMate Recommendation Approval Batch V0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "approval_batch_id",
    "created_at",
    "release_scope",
    "gate_check",
    "codex_review",
    "ethan_sample_review",
    "unresolved_blockers",
    "approval_decision"
  ],
  "properties": {
    "schema_version": {
      "const": "recommendation_approval_batch_v0.1"
    },
    "approval_batch_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "release_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "kb_pool_version",
        "rule_version",
        "model_ids"
      ],
      "properties": {
        "target": {
          "enum": ["external_mvp", "external_release_update"]
        },
        "kb_pool_version": {
          "type": "string",
          "minLength": 1
        },
        "rule_version": {
          "type": "string",
          "minLength": 1
        },
        "semantic_version": {
          "type": ["string", "null"]
        },
        "model_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "gate_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "report_ref", "checked_count", "passed_count", "failures"],
      "properties": {
        "status": {
          "enum": ["pending", "pass", "fail"]
        },
        "report_ref": {
          "type": ["string", "null"]
        },
        "checked_count": {
          "type": "integer",
          "minimum": 0
        },
        "passed_count": {
          "type": "integer",
          "minimum": 0
        },
        "failures": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["model_id", "reason_code"],
            "properties": {
              "model_id": {"type": "string"},
              "reason_code": {"type": "string"},
              "detail": {"type": ["string", "null"]}
            }
          }
        }
      }
    },
    "codex_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "review_ref", "reviewed_count", "findings"],
      "properties": {
        "status": {
          "enum": ["pending", "completed", "blocked"]
        },
        "review_ref": {
          "type": ["string", "null"]
        },
        "reviewed_count": {
          "type": "integer",
          "minimum": 0
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["model_id", "finding_type", "resolution_status"],
            "properties": {
              "model_id": {"type": "string"},
              "finding_type": {"type": "string"},
              "detail": {"type": ["string", "null"]},
              "resolution_status": {
                "enum": ["resolved", "unresolved", "accepted_product_risk"]
              }
            }
          }
        }
      }
    },
    "ethan_sample_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "sampling_method",
        "sample_rate",
        "seed",
        "population_count",
        "sample_count",
        "sampled_model_ids",
        "findings"
      ],
      "properties": {
        "status": {
          "enum": ["pending", "completed", "blocked"]
        },
        "sampling_method": {
          "const": "deterministic_random"
        },
        "sample_rate": {
          "const": 0.1
        },
        "seed": {
          "type": "string",
          "minLength": 1
        },
        "population_count": {
          "type": "integer",
          "minimum": 1
        },
        "sample_count": {
          "type": "integer",
          "minimum": 1
        },
        "sampled_model_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["model_id", "result"],
            "properties": {
              "model_id": {"type": "string"},
              "result": {"enum": ["pass", "issue_found"]},
              "detail": {"type": ["string", "null"]}
            }
          }
        }
      }
    },
    "unresolved_blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["blocker_type", "detail"],
        "properties": {
          "blocker_type": {
            "enum": ["product_policy", "official_price", "sale_status", "gate_failure", "review_finding", "other"]
          },
          "model_id": {"type": ["string", "null"]},
          "detail": {"type": "string"}
        }
      }
    },
    "approval_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "decision_role", "decision_by", "decided_at", "notes"],
      "properties": {
        "status": {
          "enum": ["draft", "blocked", "approved", "revoked"]
        },
        "decision_role": {
          "const": "product_owner"
        },
        "decision_by": {
          "type": ["string", "null"]
        },
        "decided_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "notes": {
          "type": ["string", "null"]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "approval_decision": {
            "properties": {"status": {"const": "approved"}},
            "required": ["status"]
          }
        }
      },
      "then": {
        "properties": {
          "gate_check": {
            "properties": {"status": {"const": "pass"}}
          },
          "codex_review": {
            "properties": {"status": {"const": "completed"}}
          },
          "ethan_sample_review": {
            "properties": {"status": {"const": "completed"}}
          },
          "unresolved_blockers": {
            "maxItems": 0
          },
          "approval_decision": {
            "properties": {
              "decision_by": {"type": "string", "minLength": 1},
              "decided_at": {"type": "string", "format": "date-time"}
            }
          }
        }
      }
    }
  ]
}
